<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <linearGradient id="skyGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3c1e45"/>
      <stop offset="50%" stop-color="#5a295c"/>
      <stop offset="100%" stop-color="#73366c"/>
    </linearGradient>
    <radialGradient id="glow2" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#f7c8d0" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#f7c8d0" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="600" height="600" fill="url(#skyGrad2)"/>
  <circle cx="300" cy="260" r="180" fill="url(#glow2)"/>

  <!-- Stars & sparkles -->
  <g fill="#ffd56b" opacity="0.8">
    <circle cx="120" cy="150" r="3"/>
    <circle cx="480" cy="110" r="3"/>
    <circle cx="140" cy="410" r="2.5"/>
    <circle cx="460" cy="380" r="3"/>
    <polygon points="450,180 453,190 463,193 453,196 450,206 447,196 437,193 447,190" fill="#ffd56b"/>
  </g>

  <!-- Heart & Moon Motif -->
  <g transform="translate(250, 180)" fill="#faf3e8" opacity="0.95">
    <path d="M50 85 C50 85, 10 50, 10 25 A 22 22 0 0 1 50 20 A 22 22 0 0 1 90 25 C 90 50, 50 85, 50 85 Z" fill="#e85d75" stroke="#faf3e8" stroke-width="4"/>
    <circle cx="75" cy="15" r="12" fill="#ffd56b"/>
    <circle cx="79" cy="13" r="10" fill="#5a295c"/>
  </g>

  <text x="300" y="365" font-family="'Playfair Display', Georgia, serif" font-size="28" fill="#faf3e8" font-weight="600" text-anchor="middle" letter-spacing="1">
    Memory Two 🌙
  </text>
  <text x="300" y="405" font-family="'Inter', sans-serif" font-size="16" fill="#f7c8d0" text-anchor="middle">
    Add another moment worth remembering
  </text>
  <text x="300" y="445" font-size="22" text-anchor="middle">
    ✨ 💖 ✨
  </text>
</svg>
